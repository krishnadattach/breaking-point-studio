# Copy this file to ".env" and fill in your own values. ".env" is never committed.

# --- Claude API (https://console.anthropic.com -> API keys) ---
ANTHROPIC_API_KEY=

# --- Web search for the research step (Tavily has a free tier: https://tavily.com) ---
TAVILY_API_KEY=

# --- MySQL (must be MySQL 8+) ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=bp_app
MYSQL_PASSWORD=
MYSQL_DATABASE=breaking_point

# --- Models: cheap one for simple steps, better one for writing ---
MODEL_CHEAP=claude-haiku-5-5
MODEL_WRITER=claude-sonnet-5-5

# --- Tools ---
BLENDER_PATH=C:\Program Files\Blender Foundation\Blender 5.2\blender.exe
